NODE_ENV=production

# PostgreSQL credentials for the Postgres container in docker-compose-prod.yml.
# POSTGRES_USER and POSTGRES_DB are our choices; they are not AWS values.
# Generate POSTGRES_PASSWORD ourself, for example: openssl rand -base64 32
# Store the real file only on each EC2 instance (or retrieve it from SSM Parameter Store).
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pulsemetrics
POSTGRES_PORT=5432

# Internal Docker-network endpoints. Keep these values unless we change the Compose service names.
REDIS_URL=redis://redis:6379
KAFKA_BROKER=kafka:9092

# Do not copy this from AWS: deploy-backend.sh replaces it with each EC2 instance's private IP.
KAFKA_HOST=CHANGE_ME
